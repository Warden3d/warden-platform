# ============================================================================
# WARDEN Platform — Environment Variables (example)
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Without Supabase keys, the app falls back to local mock data.

# Supabase — Public (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — Service Role (server only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SMTP — Gmail (server only, NEVER expose to client)
# Use an App Password generated from Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
WARDEN_EMAIL=your-email@gmail.com

# Site URL (used for metadata, OG images, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000